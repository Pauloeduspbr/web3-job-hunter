# Copie para .env (não versionado) e preencha. O SDK lê ANTHROPIC_API_KEY do ambiente.
ANTHROPIC_API_KEY=sk-ant-...

# Overrides opcionais de modelo por estágio (decisão D6 da arquitetura):
# extração estruturada (barato basta) -> Haiku; nuance (tailor/judge/tradução) -> Sonnet.
# Suba para claude-opus-4-8 se quiser qualidade máxima (mais caro).
WJT_MODEL_EXTRACT=claude-haiku-4-5
WJT_MODEL_TAILOR=claude-sonnet-4-6
WJT_MODEL_JUDGE=claude-sonnet-4-6
WJT_MODEL_TRANSLATE=claude-sonnet-4-6

# Onde gravar o fact store (default: ./data/cv_master.json)
# WJT_DATA_DIR=./data
