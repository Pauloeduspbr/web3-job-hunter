# Web3 Job Hunter — environment
# Copy to .env and fill in. The app reads these via python-dotenv on startup.

# Apify token — REQUIRED to "Detalhar" (enrich) LinkedIn jobs and to run the
# LinkedIn search/scrape. Without it, jobs from the search stay listing-only
# (no description, score from title only). Get it at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Anthropic API key — OPTIONAL. If set, the app generates the tailored CV
# directly via Claude (claude-opus-4-8). If empty, the app runs in "manual"
# mode: it produces the tailoring brief and you generate the CV in Claude Code.
# Get it at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
